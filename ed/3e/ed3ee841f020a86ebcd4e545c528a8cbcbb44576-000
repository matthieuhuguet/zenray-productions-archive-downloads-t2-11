    import sys
    import csv
    import re
    import os
    import time
    from random import uniform
    from selenium import webdriver
    from selenium.webdriver.common.by import By
    from selenium.webdriver.chrome.service import Service
    from selenium.webdriver.support.ui import WebDriverWait
    from selenium.webdriver.support import expected_conditions as EC
    from webdriver_manager.chrome import ChromeDriverManager
    from bs4 import BeautifulSoup
    from PyQt5.QtWidgets import QApplication, QWidget, QVBoxLayout, QPushButton, QLabel, QFileDialog
    
    class DataExtractor:
        """
        Classe dédiée à l'extraction des données à partir du contenu HTML.
        Utilise BeautifulSoup pour parser le HTML et applique des expressions régulières sur le texte brut.
        """
        def __init__(self, html_content):
            self.soup = BeautifulSoup(html_content, 'html.parser')
            self.text = self.soup.get_text(separator=" ", strip=True)
    
        def extract_email(self):
            emails = re.findall(r'\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b', self.text)
            return emails[0] if emails else None
    
        def extract_phone(self):
            phones = re.findall(r'\b(0[1-9](?:[\s.-]?\d{2}){4})\b', self.text)
            return phones[0] if phones else None
    
        def extract_specializations(self):
            """
            Recherche les spécialisations juridiques dans le texte en se basant sur une liste prédéfinie.
            Pour chaque spécialité présente dans le texte, on l'ajoute à une liste.
            Les spécialisations trouvées sont jointes par " | " pour former la valeur de la colonne Spécialisation_1.
            """
            specializations_keywords = [
                "droit social", "droit du travail", "droit commercial", "droit pénal", 
                "droit de la famille", "droit immobilier", "droit administratif", 
                "droit international", "droit fiscal", "droit civil", "droit des assurances",
                "droit des entreprises", "droit collaboratif", "droit des personnes"
            ]
            found_specs = []
            for keyword in specializations_keywords:
                if re.search(r'\b' + re.escape(keyword) + r'\b', self.text, re.IGNORECASE):
                    found_specs.append(keyword.capitalize())
            found_specs = list(dict.fromkeys(found_specs))
            return " | ".join(found_specs)
    
        def extract_mediator(self):
            """
            Détecte si l'un des termes ou contextes suivants apparaît dans le texte :
             - Expressions telles que "exerce en tant que médiateur", "agit en tant que médiatrice", etc.
             - Les mots simples "médiateur", "médiatrice" ou "médiation".
            
            Si l'un de ces motifs est trouvé, la fonction retourne "Oui", sinon "Non".
            """
            patterns = [
                r'\b(?:exerce|agit|intervient|est|a été|sert de)\s+(?:en tant que\s+)?médiateur\b',
                r'\b(?:exerce|agit|intervient|est|a été|sert de)\s+(?:en tant que\s+)?médiatrice\b',
                r'\bmédiateur\b',
                r'\bmédiatrice\b',
                r'\bmédiation\b'
            ]
            for pattern in patterns:
                if re.search(pattern, self.text, re.IGNORECASE):
                    return "Oui"
            return "Non"
    
        def extract_metier(self):
            """
            Recherche les métiers dans le texte parmi une liste de mots-clés.
            Si plusieurs métiers sont trouvés, ils sont joints par une virgule.
            """
            metiers = []
            for m in ["avocat", "médiateur", "juriste"]:
                if re.search(r'\b' + re.escape(m) + r'\b', self.text, re.IGNORECASE):
                    metiers.append(m)
            metiers = list(dict.fromkeys(metiers))
            return ", ".join(metiers) if metiers else ""
    
        def extract_fonction(self):
            """
            Identifie la ou les fonctions juridiques en parcourant un dictionnaire de catégories.
            Pour chaque catégorie, si au moins un mot-clé associé est trouvé dans le texte,
            la catégorie est ajoutée à la liste.
            """
            functions = {
                "Représentation légale": ["plaider", "tribunaux", "défendre", "actes juridiques"],
                "Conseil juridique": ["conseil", "avis juridique", "rédiger des contrats", "conformité", "rgpd", "droit des sociétés"],
                "Médiation et résolution des conflits": ["médiation", "résolution des conflits", "accord à l’amiable", "désamorcer"],
                "Arbitrage privé": ["arbitrage", "sentence arbitrale", "trancher des différends"],
                "Rédaction et vérification de documents légaux": ["rédaction de contrats", "vérification de documents", "testament", "actes notariés"],
                "Droit de la famille": ["divorce", "garde d’enfants", "pension alimentaire", "succession"],
                "Droit des affaires et fiscalité": ["fiscal", "fusion", "acquisition", "contrôle fiscal", "redressements"],
                "Droit pénal": ["défense", "accusé", "infractions", "fraude"],
                "Droit social / droit du travail": ["conflits de travail", "licenciement", "convention collective"],
                "Droit immobilier": ["baux", "locatifs", "urbanisme", "vente de biens immobiliers"],
                "Droit administratif": ["administrations", "autorisation", "décision administrative", "marchés publics"],
                "Droit international": ["international", "investissements étrangers", "contrats internationaux", "expulsions", "visa"]
            }
            found_functions = []
            for func, keywords in functions.items():
                for keyword in keywords:
                    if re.search(keyword, self.text, re.IGNORECASE):
                        found_functions.append(func)
                        break
            found_functions = list(dict.fromkeys(found_functions))
            return ", ".join(found_functions) if found_functions else ""
    
        def extract_all(self):
            """
            Retourne un dictionnaire complet avec toutes les informations extraites.
            La colonne 'Spécialisation_1' contiendra toutes les spécialisations trouvées séparées par " | ".
            """
            return {
                'Email': self.extract_email(),
                'Téléphone': self.extract_phone(),
                'Spécialisation_1': self.extract_specializations(),
                'Spécialisation_2': "",  # Optionnel
                'Médiateur_?': self.extract_mediator(),
                'Métier': self.extract_metier(),
                'Fonction': self.extract_fonction()
            }
    
    class LawyerEmailScraper(QWidget):
        def __init__(self):
            super().__init__()
            self.csv_file = None
            self.setup_ui()
            self.column_order = [
                'Nom', 'Prénom', 'Email', 'Téléphone', 'Médiateur_?', 'Métier', 'Fonction',
                'Spécialisation_1', 'RaisonSociale', 'Siret/Siren', 'Adresse_1', 'Ville',
                'Code_Postal', 'Date_Serment[y_m_d]', 'Langues_parlées', 'Adresse_2',
                'Spécialisation_2', 'Spécialisation_3', 'Nom_Barreau'
            ]
    
        def setup_ui(self):
            self.setWindowTitle("Scraper Emails Avocats - Respect des Colonnes")
            self.setGeometry(200, 200, 600, 250)
            layout = QVBoxLayout()
            self.label = QLabel("Sélectionnez un fichier CSV avec noms et prénoms des avocats.")
            layout.addWidget(self.label)
            self.file_btn = QPushButton("Choisir le fichier CSV")
            self.file_btn.clicked.connect(self.select_file)
            layout.addWidget(self.file_btn)
            self.scrape_btn = QPushButton("Lancer la collecte de données")
            self.scrape_btn.clicked.connect(self.launch_scraping)
            layout.addWidget(self.scrape_btn)
            self.setLayout(layout)
    
        def select_file(self):
            file, _ = QFileDialog.getOpenFileName(self, "Ouvrir CSV", "", "CSV Files (*.csv)")
            if file:
                self.csv_file = file
                self.label.setText(f"Fichier sélectionné : {file}")
            else:
                self.label.setText("Aucun fichier sélectionné.")
    
        def launch_scraping(self):
            if not self.csv_file:
                self.label.setText("Veuillez d'abord sélectionner un fichier CSV.")
                return
            output_file = os.path.join(os.path.dirname(self.csv_file), "avocats_complet.csv")
            self.label.setText("Lancement du scraping...")
            options = webdriver.ChromeOptions()
            options.add_argument("--disable-blink-features=AutomationControlled")
            options.add_experimental_option("excludeSwitches", ["enable-automation"])
            # options.add_argument("--headless")  # Décommentez pour exécuter en mode headless
            try:
                driver = webdriver.Chrome(service=Service(ChromeDriverManager().install()), options=options)
            except Exception as e:
                self.label.setText(f"Erreur lors du lancement du driver : {str(e)}")
                return
            try:
                with open(self.csv_file, 'r', encoding='utf-8') as infile, \
                     open(output_file, 'w', newline='', encoding='utf-8') as outfile:
                    reader = csv.DictReader(infile)
                    writer = csv.DictWriter(outfile, fieldnames=self.column_order)
                    writer.writeheader()
                    for row in reader:
                        for col in self.column_order:
                            if col not in row:
                                row[col] = ""
                        queries = [
                            f"{row['Nom']} {row['Prénom']} avocat",
                            f"{row['Nom']} {row['Prénom']} médiateur",
                            f"{row['Nom']} {row['Prénom']} droit"
                        ]
                        combined_result = {}
                        for query in queries:
                            current_result = self.scrape_with_query(driver, query)
                            for key, value in current_result.items():
                                if key == "Médiateur_?":
                                    # Si une requête retourne "Oui", forcer la valeur à "Oui"
                                    if value == "Oui":
                                        combined_result[key] = "Oui"
                                    elif key not in combined_result:
                                        combined_result[key] = value
                                else:
                                    if value and (key not in combined_result or combined_result[key] == ""):
                                        combined_result[key] = value
                        if combined_result.get('Email'):
                            row['Email'] = combined_result.get('Email')
                        if combined_result.get('Téléphone'):
                            row['Téléphone'] = combined_result.get('Téléphone')
                        if combined_result.get('Spécialisation_1'):
                            row['Spécialisation_1'] = combined_result.get('Spécialisation_1')
                        if combined_result.get('Spécialisation_2'):
                            row['Spécialisation_2'] = combined_result.get('Spécialisation_2')
                        row['Médiateur_?'] = combined_result.get('Médiateur_?', "Non")
                        row['Métier'] = combined_result.get('Métier', "")
                        row['Fonction'] = combined_result.get('Fonction', "")
                        writer.writerow(row)
                        time.sleep(uniform(0.5, 1.5))
                self.label.setText(f"Traitement terminé ! Fichier généré : {output_file}")
                print(f"Traitement terminé ! Fichier généré : {output_file}")
            except Exception as e:
                self.label.setText(f"Erreur durant le scraping : {str(e)}")
                print(f"Erreur durant le scraping : {str(e)}")
            finally:
                driver.quit()
    
        def scrape_with_query(self, driver, query):
            result = {}
            try:
                search_url = "https://www.google.com/search?q=" + query.replace(" ", "+")
                driver.get(search_url)
                if self.detect_captcha(driver):
                    self.handle_captcha(driver)
                links = WebDriverWait(driver, 10).until(
                    EC.presence_of_all_elements_located((By.CSS_SELECTOR, "div.g a"))
                )
                for link in links[:3]:
                    try:
                        url = link.get_attribute('href')
                        if any(domain in url for domain in ['linkedin.com', 'predictice.com', 'facebook.com']):
                            continue
                        print(f"Tentative sur {url} pour la requête '{query}'")
                        driver.switch_to.new_window('tab')
                        driver.get(url)
                        WebDriverWait(driver, 10).until(
                            EC.presence_of_element_located((By.TAG_NAME, 'body'))
                        )
                        extractor = DataExtractor(driver.page_source)
                        data = extractor.extract_all()
                        result.update({k: v for k, v in data.items() if v or k == "Médiateur_?"})
                        driver.close()
                        driver.switch_to.window(driver.window_handles[0])
                        if result.get('Email'):
                            break
                    except Exception as e:
                        print(f"Erreur sur {url} : {str(e)}")
                        if len(driver.window_handles) > 1:
                            driver.close()
                            driver.switch_to.window(driver.window_handles[0])
            except Exception as e:
                print(f"Erreur lors de la recherche avec la requête '{query}' : {str(e)}")
            return result
    
        def detect_captcha(self, driver):
            try:
                iframe = driver.find_element(By.CSS_SELECTOR, "iframe[src*='recaptcha']")
                return iframe.is_displayed()
            except Exception:
                return False
    
        def handle_captcha(self, driver):
            print("CAPTCHA détecté ! Veuillez le résoudre manuellement...")
            start_time = time.time()
            while time.time() - start_time < 120:
                if not self.detect_captcha(driver):
                    print("CAPTCHA résolu.")
                    return
                time.sleep(5)
            raise Exception("CAPTCHA non résolu dans le temps imparti.")
    
    if __name__ == "__main__":
        app = QApplication(sys.argv)
        window = LawyerEmailScraper()
        window.show()
        sys.exit(app.exec_())
